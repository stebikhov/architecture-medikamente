                    </mxGeometry>
                </mxCell>
                <mxCell id="p4-f6" edge="1" parent="1" source="p4-p1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" target="p4-e1" value="[C4] заключение и рекомендации&lt;br&gt;To-Be: Д — пациент видит только&lt;div&gt;&amp;nbsp;свои данные&lt;/div&gt;">
                    <mxGeometry relative="1" x="0.1579" y="-35" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p4-e4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="E4. Outlook / Exchange (вложения)" vertex="1">
                    <mxGeometry height="70" width="200" x="890" y="370" as="geometry"/>
                </mxCell>
                <mxCell id="p4-f7" edge="1" parent="1" source="p4-d2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;labelBackgroundColor=#ffffff;exitX=1;exitY=1;exitDx=0;exitDy=-12;exitPerimeter=0;" target="p4-e4" value="[C4] результаты анализов во вложениях&lt;br&gt;To-Be: Д — запрет пересылки C4&amp;nbsp;&lt;div&gt;вне защищённого канала (DLP);&amp;nbsp;&lt;div&gt;Ш — защищённый канал; Т — ПД(здоровье)&lt;/div&gt;&lt;/div&gt;">
                    <mxGeometry relative="1" x="-0.1919" y="28" as="geometry">
